---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Terminal from '../components/Terminal.astro';
const { title = 'Adam Idris — Software for everyday work', description = 'Full-stack product engineer in Johor, Malaysia. Selected operational systems and independent products by Adam Idris.', sound = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ddd9ce" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Set the theme before first paint: saved choice, else the system setting.
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/">Adam Idris<span aria-hidden="true">.</span></a>
      <nav aria-label="Site">
        {sound && (
          <button class="sound-toggle" type="button" aria-label="Page-turn sound" aria-pressed="false" title="Page-turn sound">
            <span class="sound-icon sound-off"><Icon name="bi-volume-mute" /></span>
            <span class="sound-icon sound-on"><Icon name="bi-volume-up" /></span>
          </button>
        )}
        <Terminal />
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
          <span class="theme-icon theme-icon-moon"><Icon name="bi-moon-stars" /></span>
          <span class="theme-icon theme-icon-sun"><Icon name="bi-sun" /></span>
        </button>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <p>Thanks for stopping by.</p>
      <span>Adam Idris · Johor, Malaysia</span>
      <span class="footer-links">
        <a class="icon-link" href="https://github.com/damderis" target="_blank" rel="noopener noreferrer"><Icon name="bi-github" />GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="icon-link" href="https://www.linkedin.com/in/adam-idris-650b33306" target="_blank" rel="noopener noreferrer"><Icon name="bi-linkedin" />LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="icon-link" href="/Adam_Idris_Resume_2026.pdf" download><Icon name="bi-file-earmark-pdf" />Resume (PDF)</a>
      </span>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
    <script>
      // Theme toggle. In both directions the old view stays on top and only its clip moves, so both
      // themes' content is visible the whole time. Light→dark: the old view shrinks into the centre.
      // Dark→light: a hole opens in the old view from the centre outwards. Instant without View
      // Transitions or with reduced motion.
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!;
      const sync = () => {
        const dark = root.dataset.theme === 'dark';
        toggle.setAttribute('aria-pressed', String(dark));
        meta.content = dark ? '#121618' : '#ddd9ce';
      };
      sync();
      // A click during a switch is remembered, not started on top of it: starting a new view transition
      // cancels the running one mid-circle, which is the stutter. When a switch ends, the next one runs.
      let wanted = root.dataset.theme, busy = false;
      const run = () => {
        const next = wanted;
        if (busy || next === root.dataset.theme) return;
        const apply = () => {
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          sync();
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
        busy = true;
        const w = innerWidth, h = innerHeight, x = w / 2, y = h / 2, r = Math.hypot(x, y);
        const circle = (radius: number) => `circle(${radius}px at ${x}px ${y}px)`;
        // The whole screen minus a circle of this radius (even-odd fill turns the circle into a hole).
        const hole = (radius: number) => `path(evenodd, "M0 0H${w}V${h}H0Z M${x - radius} ${y}a${radius} ${radius} 0 1 0 ${2 * radius} 0a${radius} ${radius} 0 1 0 ${-2 * radius} 0Z")`;
        const transition = document.startViewTransition(apply);
        transition.ready.then(() => {
          // fill: 'forwards' holds the last frame; without it the old view pops back for a frame before the transition ends.
          const options = { duration: 700, easing: 'cubic-bezier(.4, 0, .2, 1)', fill: 'forwards' as FillMode, pseudoElement: '::view-transition-old(root)' };
          root.animate({ clipPath: next === 'dark' ? [circle(r), circle(0)] : [hole(.01), hole(r)] }, options);
        });
        transition.finished.finally(() => { busy = false; run(); });
      };
      toggle.addEventListener('click', () => { wanted = wanted === 'dark' ? 'light' : 'dark'; run(); });

      // Page-turn sound, off by default. A paper flick made from filtered noise, so there is no audio file to load.
      const soundToggle = document.querySelector<HTMLButtonElement>('.sound-toggle');
      if (soundToggle) {
        let on = false, ctx: AudioContext | undefined;
        try { on = localStorage.getItem('sound') === 'on'; } catch {}
        const show = () => soundToggle.setAttribute('aria-pressed', String(on));
        show();
        soundToggle.addEventListener('click', () => {
          on = !on; show();
          try { localStorage.setItem('sound', on ? 'on' : 'off'); } catch {}
          if (on) flick();
        });
        const flick = () => {
          ctx ??= new AudioContext();
          const t = ctx.currentTime, length = Math.floor(ctx.sampleRate * .32);
          const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < length; i++) { const x = i / length; data[i] = (Math.random() * 2 - 1) * Math.min(1, x / .06) * (1 - x) ** 2; }
          const noise = new AudioBufferSourceNode(ctx, { buffer });
          const filter = new BiquadFilterNode(ctx, { type: 'bandpass', Q: .7 });
          filter.frequency.setValueAtTime(3800, t);
          filter.frequency.exponentialRampToValueAtTime(900, t + .3);
          const gain = new GainNode(ctx, { gain: .35 });
          noise.connect(filter).connect(gain).connect(ctx.destination);
          noise.start(t);
        };
        // Stamp landing: a short low thump plus a muffled slap.
        const thud = () => {
          ctx ??= new AudioContext();
          const t = ctx.currentTime;
          const body = new OscillatorNode(ctx, { type: 'sine', frequency: 140 });
          body.frequency.exponentialRampToValueAtTime(55, t + .12);
          const bodyGain = new GainNode(ctx, { gain: .6 });
          bodyGain.gain.exponentialRampToValueAtTime(.001, t + .16);
          body.connect(bodyGain).connect(ctx.destination);
          body.start(t); body.stop(t + .18);
          const length = Math.floor(ctx.sampleRate * .06);
          const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < length; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / length) ** 3;
          const slap = new AudioBufferSourceNode(ctx, { buffer });
          slap.connect(new BiquadFilterNode(ctx, { type: 'lowpass', frequency: 900 })).connect(new GainNode(ctx, { gain: .5 })).connect(ctx.destination);
          slap.start(t);
        };
        document.addEventListener('page-turn', () => { if (on) flick(); });
        document.addEventListener('stamp', () => { if (on) thud(); });
      }
    </script>
  </body>
</html>
