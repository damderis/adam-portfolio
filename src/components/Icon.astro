---
// Inline SVG icon from src/assets/icons. `color` sets the brand colour; otherwise it follows the text.
// Without an SVG it falls back to a lettered badge in the brand colour.
const icons = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, label = '', color } = Astro.props;
const raw = name ? icons[`../assets/icons/${name}.svg`] : null;
const svg = raw && raw
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(/\s(class|role|width|height|fill)="[^"]*"/g, '')
  .replace('<svg', `<svg class="icon" aria-hidden="true" focusable="false" fill="currentColor"${color ? ` style="color:${color}"` : ''}`);
---
{svg ? <Fragment set:html={svg} /> : <span class="icon icon-letter" aria-hidden="true" style={color ? `background:${color}` : undefined}>{label.slice(0, 1)}</span>}
