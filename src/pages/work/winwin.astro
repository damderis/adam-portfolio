---
import Base from '../../layouts/Base.astro';
import { numbers, groups, process } from '../../data/winwin.js';
const id = title => 'g-' + title.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base title="More from WinWin — Adam Idris" description="Other ERP, AI and DevOps work at WinWin Food Industries Sdn Bhd by Adam Idris.">
  <article class="case">
    <div class="wrap">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Back to the workbook</a>
      <header class="case-header">
        <p class="eyebrow">ERP systems · 2026</p>
        <h1>More from WinWin</h1>
        <p class="case-deck">Everything else I’ve built at WinWin Food Industries Sdn Bhd, an F&amp;B manufacturer and distributor in Malaysia.</p>
      </header>

      <dl class="numbers">
        {numbers.map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>

      <p class="index-note">Screens from these systems show real company data, so each one is described in its own case study rather than shown.</p>

      {groups.map(group => (
        <section class="work-group" aria-labelledby={id(group.title)}>
          <h2 id={id(group.title)}>{group.title}</h2>
          <ul class="work-cards">
            {group.items.map(item => (
              <li class="work-card">
                <h3>{item.name}</h3>
                <p>{item.text}</p>
                <p class="work-tags">{item.tags}</p>
                <a class="text-link" href={item.link ?? `/work/winwin/${item.slug}/`}>Read the case study<span class="sr-only">: {item.name}</span> <span aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="work-group" aria-labelledby="g-process">
        <h2 id="g-process">How the work gets done</h2>
        <ul class="process-list">{process.map(line => <li>{line}</li>)}</ul>
      </section>

      <nav class="next-project" aria-label="More case studies">
        <a href="/work/delivery-workflow/"><span class="label">Case study</span><span class="next-name"><span aria-hidden="true">←</span> Delivery workflow</span></a>
        <a href="/work/production-planning/"><span class="label">Case study</span><span class="next-name">Production planning <span aria-hidden="true">→</span></span></a>
      </nav>
    </div>
  </article>
</Base>
