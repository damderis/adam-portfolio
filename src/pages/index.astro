---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import Shots from '../components/Shots.astro';
import { projects } from '../data/projects.js';
import { portrait, shotsFor } from '../data/images.js';
const hasShots = p => { const s = shotsFor(p.slug); return Boolean(s.desktop || s.phones.length); };
// Pull-out preview on phones: the mobile web capture ("Web UI") or the app's phone screens ("App UI").
const peekOf = p => {
  const s = shotsFor(p.slug);
  if (s.mobile) return { label: 'Web UI', images: [[s.mobile, p.shots?.mobile ?? `${p.name} on a phone`]] };
  if (s.phones.length) return { label: 'App UI', images: s.phones.map((image, i) => [image, `${p.name} app, screen ${i + 1}`]) };
  return null;
};
import { journey } from '../data/journey.js';
import { skills, strengths, profiles } from '../data/skills.js';
import Icon from '../components/Icon.astro';
import iconColors from '../data/icon-colors.json';
const logos = import.meta.glob('../assets/logos/*.png', { eager: true, import: 'default' });
const logo = name => logos[`../assets/logos/${name}.png`];
// Contents grouped by kind of work; the projects keep their running numbers.
const groupOf = p => p.kind.startsWith('Independent') ? 'My own products' : p.kind === 'ERP system' ? 'Day job at WinWin' : p.kind.startsWith('Freelance') ? 'Freelance gigs' : 'Just for fun';
const contentsGroups = ['My own products', 'Day job at WinWin', 'Freelance gigs', 'Just for fun'].map(title => ({
  title,
  projects: projects.filter(p => groupOf(p) === title),
  more: title === 'Day job at WinWin' ? { href: '/work/winwin/', label: 'More from WinWin' } : null,
}));
---
<Base sound>
  <div class="workbook wrap" id="work">
    <div class="book-frame">
      <div class="book" role="region" aria-label="Portfolio workbook">
        <div class="front-cover paper" hidden>
          <div class="cover-frame">
            <div class="cover-top">
              <p class="cover-kicker">Things I built · Vol. I</p>
              <Image class="cover-portrait" src={portrait} alt="" width={128} height={128} format="webp" />
            </div>
            <p class="cover-title" tabindex="-1">Adam’s<br /><em>workbook.</em></p>
            <p class="cover-sub">Eight projects: systems for a food factory, a wedding invite builder, and a dashboard for my own car.</p>
            <ol class="cover-index" aria-label="Inside this workbook">
              {projects.map(p => <li><span>{p.number}</span> {p.name}</li>)}
            </ol>
            <div class="cover-bottom">
              <p class="cover-hint" aria-hidden="true">Click anywhere. It opens, promise.</p>
              <p class="cover-author">Adam Idris</p>
            </div>
          </div>
          <a class="cover-open" href="#work"><span class="sr-only">Open the workbook</span></a>
        </div>

        <section class="spread spread-intro" data-hash="work" data-title="Contents" data-name="Contents" aria-labelledby="intro-title">
          <div class="paper intro-leaf">
            <p class="eyebrow">Full-stack dev · Johor, Malaysia</p>
            <h1 id="intro-title" tabindex="-1">Hi, I’m Adam.<br /><em>I build things.</em></h1>
            <p class="lede">By day I build ERP systems for a food manufacturer. On the side I run my own products and tinker with Android.</p>
            <p class="annotation">factory floors, wedding invites, my car. yes, really.</p>
            <dl class="facts">
              <div><dt>Building</dt><dd>Bokkeh and MomenLoka. Both mine.</dd></div>
              <div><dt>Day job</dt><dd>Delivery and production systems at WinWin Food Industries</dd></div>
              <div><dt>Toolkit</dt><dd>TypeScript · Vue · Python · Frappe / ERPNext · Convex · Android</dd></div>
            </dl>
            <span class="folio">Adam Idris · Selected work</span>
          </div>
          <div class="paper contents-leaf">
            <h2 class="eyebrow" id="contents-title">Contents</h2>
            {contentsGroups.map(group => (
              <div class="contents-group">
                <h3 class="contents-group-title">{group.title}</h3>
                <ol class="contents">
                  {group.projects.map(p => (
                    <li>
                      <a class="contents-link" href={`#page-${p.slug}`}>
                        <span class="contents-num">{p.number}</span>
                        <span class="contents-name">{p.name}</span>
                        <span class="contents-kind">{p.kind}</span>
                        <span class="contents-summary">{p.summary}</span>
                      </a>
                      <a class="contents-case" href={`/work/${p.slug}/`}>Case study<span class="sr-only">: {p.name}</span> <span aria-hidden="true">→</span></a>
                    </li>
                  ))}
                  {group.more && (
                    <li>
                      <a class="contents-link" href={group.more.href}>
                        <span class="contents-num" aria-hidden="true">+</span>
                        <span class="contents-name">{group.more.label}</span>
                        <span class="contents-kind">Index</span>
                      </a>
                    </li>
                  )}
                </ol>
              </div>
            ))}
            <p class="contents-extra"><a href="#about">About me</a><a href="#journey">How I got here</a></p>
            <span class="folio">Contents</span>
          </div>
        </section>

        {projects.map(p => (
          <section id={`page-${p.slug}`} class="spread" data-hash={`page-${p.slug}`} data-title={`${p.number} / ${String(projects.length).padStart(2, '0')} · ${p.name}`} data-name={p.name} aria-labelledby={`title-${p.slug}`}>
            <div class="paper project-notes">
              <p class="eyebrow">{p.number} / {p.kind}</p>
              <span class="stamp stamp-phone" aria-hidden="true" data-stamp={p.stamp.toLowerCase().replace(/ /g, '-')}>{p.stamp}</span>
              <h2 id={`title-${p.slug}`} tabindex="-1">{p.name}</h2>
              <p class="project-summary">{p.summary}</p>
              <p class="annotation note-phone" aria-hidden="true">{p.note}</p>
              <p class="project-detail">{p.detail}</p>
              <div class="hard"><p class="label">The hard part</p><p>{p.hard}</p></div>
              <p class="stack"><span class="label">Built with</span> {p.stack}</p>
              <div class="project-links">
                <a class="button-link" href={`/work/${p.slug}/`}>Read the case study<span class="sr-only">: {p.name}</span> <span aria-hidden="true">→</span></a>
                {p.link && <a class="text-link" href={p.link} target="_blank" rel="noopener noreferrer">{p.action} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
              </div>
              <span class="folio">{p.name} · {p.kind}</span>
            </div>
            {peekOf(p) && (
              <>
                <button class="peek-handle" type="button" popovertarget={`peek-${p.slug}`} data-peek={`peek-${p.slug}`} aria-label={`Show the ${p.name} ${peekOf(p).label}`}>
                  <Icon name="bi-phone" /><span>{peekOf(p).label}</span>
                </button>
                <div class="peek" id={`peek-${p.slug}`} popover aria-label={`${p.name} ${peekOf(p).label}`}>
                  <button class="peek-close" type="button" popovertarget={`peek-${p.slug}`} popovertargetaction="hide" aria-label="Close preview"><Icon name="bi-x-lg" /></button>
                  <div class="peek-track" tabindex={peekOf(p).images.length > 1 ? 0 : undefined} aria-label={peekOf(p).images.length > 1 ? 'Swipe between screens' : undefined}>
                    {peekOf(p).images.map(([image, alt]) => (
                      <div class="peek-slide"><Image src={image} alt={alt} widths={[390, 780]} sizes="(max-width: 699px) 92vw, 1px" loading="lazy" draggable="false" /></div>
                    ))}
                  </div>
                  {peekOf(p).images.length > 1 && (
                    <div class="peek-dots" aria-hidden="true">{peekOf(p).images.map((_, i) => <span class:list={[{ on: i === 0 }]} />)}</div>
                  )}
                </div>
              </>
            )}
            <div class="paper project-art">
              <span class="stamp" data-stamp={p.stamp.toLowerCase().replace(/ /g, '-')}>{p.stamp}</span>
              {hasShots(p) ? <Shots project={{ shots: {}, ...p }} /> : <FlowDiagram steps={p.flow} />}
              <p class="annotation">{p.note}</p>
              <span class="folio">{p.name} · Details</span>
            </div>
          </section>
        ))}

        <section class="spread" id="about" data-hash="about" data-title="About" data-name="About" aria-labelledby="about-title">
          <div class="paper about-leaf">
            <div class="about-head">
              <Image class="portrait" src={portrait} alt="Adam Idris" width={224} height={224} format="webp" loading="lazy" />
              <div class="about-id">
                <p class="about-name">Adam Idris</p>
                <p class="about-role">Junior Full-Stack Developer, WinWin Food Industries</p>
                <p class="about-place"><Icon name="bi-geo-alt" />Johor, Malaysia</p>
              </div>
            </div>
            <h2 id="about-title" tabindex="-1">Front to back, <em>server included.</em></h2>
            <p class="annotation">currently levelling up: DevOps + AI agents</p>
            <div class="toolkit" aria-labelledby="toolkit-title">
              <h3 class="label" id="toolkit-title">Toolkit</h3>
              {skills.map(group => (
                <div class="toolkit-group">
                  <p class="toolkit-area">{group.area}</p>
                  <ul class="chips">
                    {group.items.map(([label, icon]) => <li class="chip"><Icon name={icon} label={label} color={iconColors[icon ?? label]} />{label}</li>)}
                  </ul>
                </div>
              ))}
            </div>
            <span class="folio">About · Adam Idris</span>
          </div>
          <div class="paper about-notes">
            <p class="lede">I’m a full-stack dev in Johor, Malaysia. I like building the boring-looking systems that quietly keep a working day running, and the occasional product of my own.</p>
            <p>At WinWin Food Industries that means delivery planning, driver tools and production workflows on Frappe and ERPNext. Outside work there’s Bokkeh and MomenLoka, plus DriveBoard and Little Things, two Android projects I mostly built for me.</p>
            <p><a class="text-link" href="/work/winwin/">More ERP, AI and DevOps work at WinWin <span aria-hidden="true">→</span></a></p>
            <div class="colophon">
              <p class="label">Live products and profiles</p>
              <ul class="icon-links">
                {profiles.map(l => <li><a class="icon-link" href={l.href} target="_blank" rel="noopener noreferrer"><Icon name={l.icon} />{l.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
              </ul>
              <div class="toolkit strengths" aria-label="Beyond the code">
                {strengths.map(group => (
                  <div class="toolkit-group">
                    <p class="toolkit-area">{group.area}</p>
                    <ul class="chips">
                      {group.items.map(([label, icon, color]) => <li class="chip"><Icon name={icon} label={label} color={color} />{label}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
              <a class="button-link resume-link" href="/Adam_Idris_Resume_2026.pdf" download><Icon name="bi-file-earmark-pdf" />Download resume <span class="resume-meta">PDF · 100 KB</span></a>
            </div>
            <span class="folio">About · Notes</span>
          </div>
        </section>

        <section class="spread spread-back" id="journey" data-hash="journey" data-title="Journey" data-name="Journey" aria-labelledby="journey-title">
          <div class="paper back-cover">
            <p class="cover-kicker">Back cover · How I got here</p>
            <h2 id="journey-title" tabindex="-1">From a networking degree to <em>shipping real systems.</em></h2>
            <ol class="timeline">
              {journey.map(j => (
                <li class:list={[{ future: j.future }]}>
                  <span class="tl-when">{j.when}</span>
                  <div class="tl-head">
                    {j.logos?.map(name => <img class="tl-logo" src={logo(name).src} width="34" height="34" alt="" loading="lazy" />)}
                    {j.monogram && <span class="tl-logo tl-monogram" aria-hidden="true">{j.monogram}</span>}
                    <p class="tl-what">{j.what}</p>
                  </div>
                  <p class="tl-where">{j.where}</p>
                  {j.note && <p class="tl-note">{j.note}</p>}
                </li>
              ))}
            </ol>
            <p class="colophon-note">You made it to the back cover. Thanks for reading. Set in Georgia and Caveat, built with Astro in Johor, Malaysia.</p>
          </div>
        </section>
      </div>

      <button class="ribbon" type="button" aria-label="Pull the ribbon: open a random project" title="Feeling lucky? Pull me." hidden></button>
      <nav class="book-tabs" aria-label="Jump to a section" hidden>
        <a href="#work" data-tab="work">Index</a>
        {projects.map(p => <a href={`#page-${p.slug}`} data-tab={`page-${p.slug}`} aria-label={`${p.number} ${p.name}`} title={p.name}>{p.number}</a>)}
        <a href="#about" data-tab="about">About</a>
        <a href="#journey" data-tab="journey">Journey</a>
      </nav>
    </div>

    <nav class="book-controls" aria-label="Workbook pages" hidden>
      <button type="button" data-direction="-1"><span aria-hidden="true">←</span> Previous</button>
      <p class="page-indicator" aria-hidden="true"></p>
      <button type="button" data-direction="1"><span class="next-label">Next</span> <span aria-hidden="true">→</span></button>
    </nav>
    <p class="sr-only" id="page-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <button class="fab" type="button" popovertarget="jump-menu" aria-label="Jump to a section"><Icon name="bi-list-ul" /></button>
    <nav class="jump-menu" id="jump-menu" popover aria-label="Jump to a section">
      <p class="label">Jump to</p>
      <ol>
        <li><a href="#work"><span>—</span>Contents</a></li>
        {projects.map(p => <li><a href={`#page-${p.slug}`}><span>{p.number}</span>{p.name}</a></li>)}
        <li><a href="/work/winwin/"><span>+</span>More from WinWin</a></li>
        <li><a href="#about"><span>—</span>About</a></li>
        <li><a href="#journey"><span>—</span>Journey</a></li>
        <li><a href="#work" data-random><span><Icon name="bi-dice-5" /></span>Surprise me</a></li>
      </ol>
    </nav>
  </div>
</Base>

<script>
  // Desktop-only enhancement: the stacked sections become a page-turning book.
  // At 1000px and below (and without JavaScript) the stacked layout is the whole experience.
  const book = document.querySelector<HTMLElement>('.book')!;
  const cover = book.querySelector<HTMLElement>('.front-cover')!;
  const spreads = Array.from(book.querySelectorAll<HTMLElement>('.spread'));
  const controls = document.querySelector<HTMLElement>('.book-controls')!;
  const tabs = document.querySelector<HTMLElement>('.book-tabs')!;
  const status = document.querySelector<HTMLElement>('#page-status')!;
  const indicator = controls.querySelector<HTMLElement>('.page-indicator')!;
  const prevButton = controls.querySelector<HTMLButtonElement>('[data-direction="-1"]')!;
  const nextButton = controls.querySelector<HTMLButtonElement>('[data-direction="1"]')!;
  const desktop = matchMedia('(min-width: 1001px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const hashes = spreads.map(s => s.dataset.hash!);
  const titles = spreads.map(s => s.dataset.title!);
  const names = spreads.map(s => s.dataset.name!);
  const nextLabel = nextButton.querySelector<HTMLElement>('.next-label')!;
  const ribbon = document.querySelector<HTMLButtonElement>('.ribbon')!;
  const TURN_MS = 450;

  let leaves: HTMLElement[] = [];
  let sheets: HTMLElement[] = [];
  let faces: HTMLElement[] = [];
  let current = 0;
  let turns = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  const active = () => sheets.length > 0;

  const indexFromHash = (hash = location.hash) => {
    if (hash === '#cover') return -1;
    const i = hashes.indexOf(hash.slice(1));
    return i < 0 ? 0 : i;
  };

  const face = (content: HTMLElement | null, back: boolean) => {
    const el = document.createElement('div');
    el.className = `sheet-face ${back ? 'sheet-back' : 'sheet-front'}`;
    if (content) el.append(content);
    faces.push(el);
    return el;
  };

  // Sheet 0 carries the cover (front) and the first left page (back); sheet n carries
  // leaf 2n-1 on its front and leaf 2n on its back, so spread s = back of s + front of s+1.
  const build = () => {
    leaves = spreads.flatMap(s => Array.from(s.querySelectorAll<HTMLElement>(':scope > .paper')));
    cover.hidden = false;
    for (let n = 0; n < Math.ceil((leaves.length + 1) / 2); n++) {
      const sheet = document.createElement('div');
      sheet.className = n === 0 ? 'book-sheet cover-sheet' : 'book-sheet';
      sheet.append(face(n === 0 ? cover : leaves[2 * n - 1], false), face(leaves[2 * n] ?? null, true));
      sheets.push(sheet);
    }
    book.replaceChildren(...sheets, ribbon);
    ribbon.hidden = false;
    book.classList.add('is-book');
    controls.hidden = false;
    tabs.hidden = false;
  };

  const teardown = () => {
    clearTimeout(timer);
    spreads.forEach((spread, i) => spread.append(...leaves.slice(2 * i, 2 * i + 2)));
    cover.hidden = true;
    book.replaceChildren(cover, ...spreads);
    ribbon.hidden = true;
    book.after(ribbon);
    book.classList.remove('is-book', 'is-closed', 'is-back');
    book.removeAttribute('aria-busy');
    controls.hidden = true;
    tabs.hidden = true;
    sheets = []; faces = []; leaves = [];
  };

  const show = (index: number, { push = false, focus = true } = {}) => {
    clearTimeout(timer);
    const previousTurns = turns;
    current = Math.max(-1, Math.min(spreads.length - 1, index));
    turns = current + 1;
    const backCover = current >= 0 && !faces[2 * current + 2]?.firstElementChild;
    book.classList.toggle('is-closed', current < 0);
    book.classList.toggle('is-back', backCover);
    sheets.forEach((sheet, n) => {
      const turned = n < turns;
      const moving = n >= Math.min(turns, previousTurns) && n < Math.max(turns, previousTurns);
      sheet.classList.toggle('is-turned', turned);
      sheet.style.zIndex = String(moving ? sheets.length * 3 + (turns > previousTurns ? sheets.length - n : n) : turned ? n + 1 : sheets.length - n);
    });
    faces.forEach(f => { f.inert = true; f.setAttribute('aria-hidden', 'true'); });
    const visible = current < 0 ? [faces[0]] : backCover ? [faces[2 * current + 1]] : [faces[2 * current + 1], faces[2 * current + 2]];
    const hash = current < 0 ? 'cover' : hashes[current];
    if (push && location.hash !== `#${hash}`) history.pushState(null, '', `#${hash}`);
    tabs.querySelectorAll('a').forEach(a => a.dataset.tab === hash ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
    prevButton.disabled = current < 0;
    nextButton.disabled = current >= spreads.length - 1;
    nextLabel.textContent = nextButton.disabled ? 'Next' : `Next: ${names[current + 1]}`;
    indicator.textContent = current < 0 ? 'Cover' : titles[current];
    const finish = () => {
      sheets.forEach((sheet, n) => { sheet.style.zIndex = String(n < turns ? n + 1 : sheets.length - n); });
      visible.forEach(f => { f.inert = false; f.removeAttribute('aria-hidden'); });
      book.removeAttribute('aria-busy');
      status.textContent = current < 0 ? 'Cover. Open the workbook to begin.' : titles[current];
      if (backCover) celebrate();
      if (!focus) return;
      const target = current < 0 ? cover.querySelector<HTMLElement>('.cover-title') : visible[0].querySelector<HTMLElement>('h1, h2');
      target?.focus({ preventScroll: true });
    };
    const animated = previousTurns !== turns && !reduced.matches;
    if (!animated) return finish();
    book.setAttribute('aria-busy', 'true');
    document.dispatchEvent(new Event('page-turn'));
    timer = setTimeout(finish, TURN_MS + 20);
  };

  // A random project spread, never the one already open.
  const randomProject = () => {
    const options = hashes.filter((h, i) => h.startsWith('page-') && i !== current);
    return options[Math.floor(Math.random() * options.length)];
  };
  ribbon.addEventListener('click', () => {
    ribbon.classList.remove('is-pulled');
    void ribbon.offsetWidth;
    ribbon.classList.add('is-pulled');
    setTimeout(() => show(hashes.indexOf(randomProject()), { push: true }), reduced.matches ? 0 : 260);
  });

  // Confetti, once, for anyone who reads to the back cover.
  let celebrated = false;
  const celebrate = () => {
    if (celebrated || reduced.matches) return;
    celebrated = true;
    const layer = document.createElement('div');
    layer.className = 'confetti';
    layer.setAttribute('aria-hidden', 'true');
    const colors = ['#305b80', '#c3a96a', '#b8432f', '#5f8f6e', '#e9c46a'];
    for (let i = 0; i < 70; i++) {
      const bit = document.createElement('i');
      bit.style.cssText = `left:${Math.random() * 100}%;background:${colors[i % colors.length]};animation-delay:${Math.random() * .6}s;--drift:${(Math.random() - .5) * 240}px;--spin:${(Math.random() - .5) * 1440}deg`;
      layer.append(bit);
    }
    document.body.append(layer);
    setTimeout(() => layer.remove(), 4200);
  };

  // First desktop visit shows the cover, then opens to the contents unless the visitor acts first.
  let interacted = false;
  for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart']) addEventListener(type, () => { interacted = true; }, { once: true, passive: true });
  const sync = (initial = false) => {
    if (desktop.matches && !active()) {
      build();
      const intro = initial && !location.hash && !reduced.matches;
      show(intro ? -1 : indexFromHash(), { focus: false });
      if (intro) setTimeout(() => { if (active() && current === -1 && !interacted) show(0, { focus: false }); }, 1400);
    }
    else if (!desktop.matches && active()) {
      teardown();
      document.getElementById(location.hash.slice(1))?.scrollIntoView();
    }
  };
  sync(true);
  if (active() && location.hash) scrollTo(0, 0);
  desktop.addEventListener('change', () => sync());

  const step = (direction: number) => show(current + direction, { push: true });
  prevButton.addEventListener('click', () => step(-1));
  nextButton.addEventListener('click', () => step(1));

  // In-page links (contents, tabs, header) turn to their spread instead of scrolling.
  document.addEventListener('click', event => {
    if (!active() || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link || link.pathname !== location.pathname) return;
    const hash = link.hash.slice(1);
    if (hash !== 'cover' && !hashes.includes(hash)) return;
    event.preventDefault();
    show(indexFromHash(link.hash), { push: true });
    if (book.getBoundingClientRect().top < 0) scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
  });
  addEventListener('popstate', () => { if (active()) show(indexFromHash()); });
  // The stamp's thud plays when its slam animation ends, so sound and picture always line up.
  document.addEventListener('animationend', event => { if (event.animationName === 'thunk') document.dispatchEvent(new Event('stamp')); });

  const editable = (target: EventTarget | null) => target instanceof Element && !!target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])');
  document.addEventListener('keydown', event => {
    if (!active() || editable(event.target) || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (event.target instanceof Element && event.target !== document.body && !event.target.closest('.workbook')) return;
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); step(event.key === 'ArrowRight' ? 1 : -1); }
  });

  const jumpMenu = document.querySelector<HTMLElement>('#jump-menu');
  jumpMenu?.addEventListener('click', event => {
    const link = (event.target as Element).closest('a');
    if (!link) return;
    jumpMenu.hidePopover?.();
    if (link.hasAttribute('data-random')) { event.preventDefault(); location.hash = randomProject(); }
  });

  const timeline = document.querySelector('.timeline');
  if (timeline) new IntersectionObserver((entries, observer) => {
    if (!active() && entries.some(e => e.isIntersecting)) { celebrate(); observer.disconnect(); }
  }, { threshold: .4 }).observe(timeline);

  // The cover portrait leans toward the cursor.
  const coverPortrait = cover.querySelector<HTMLElement>('.cover-portrait');
  cover.addEventListener('pointermove', event => {
    if (reduced.matches || !coverPortrait) return;
    const r = cover.getBoundingClientRect();
    coverPortrait.style.setProperty('--px', String((event.clientX - r.left) / r.width - .5));
    coverPortrait.style.setProperty('--py', String((event.clientY - r.top) / r.height - .5));
  });

  // Phone preview drawer: drag the right-edge tab left to pull it out, drag the drawer right to put it back.
  // Tapping the tab (popovertarget), the backdrop or Esc (light dismiss) work without the gesture.
  const dragDrawer = (start: HTMLElement, drawer: HTMLElement, opening: boolean) => {
    let x0 = 0, width = 0, active = false, moved = false;
    start.addEventListener('pointerdown', event => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (!opening && (event.target as Element).closest('.peek-close')) return;
      if (!opening && drawer.querySelectorAll('.peek-slide').length > 1) return;
      x0 = event.clientX; active = true; moved = false;
      start.setPointerCapture(event.pointerId);
    });
    start.addEventListener('pointermove', event => {
      if (!active) return;
      const dx = event.clientX - x0;
      if (!moved && Math.abs(dx) < 8) return;
      if (!moved) {
        moved = true;
        if (opening) drawer.showPopover();
        width = drawer.getBoundingClientRect().width;
        drawer.classList.add('is-dragging');
      }
      const offset = opening ? Math.max(0, width + dx) : Math.max(0, dx);
      drawer.style.setProperty('--peek-x', offset + 'px');
    });
    const end = (event: PointerEvent) => {
      if (!active) return;
      active = false;
      if (!moved) return;
      const dx = event.clientX - x0;
      drawer.classList.remove('is-dragging');
      const keepOpen = opening ? dx < -width * .25 : dx < width * .25;
      if (!keepOpen) drawer.hidePopover();
      drawer.style.removeProperty('--peek-x');
      start.addEventListener('click', e => e.preventDefault(), { once: true, capture: true });
    };
    start.addEventListener('pointerup', end);
    start.addEventListener('pointercancel', end);
  };
  // Dots follow the swipe position.
  document.querySelectorAll<HTMLElement>('.peek-track').forEach(track => {
    const dots = track.parentElement?.querySelectorAll('.peek-dots span');
    if (!dots?.length) return;
    track.addEventListener('scroll', () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((dot, i) => dot.classList.toggle('on', i === index));
    }, { passive: true });
  });
  document.querySelectorAll<HTMLElement>('.peek-handle').forEach(handle => {
    const drawer = document.getElementById(handle.dataset.peek!);
    if (drawer && 'showPopover' in drawer) { dragDrawer(handle, drawer, true); dragDrawer(drawer, drawer, false); }
  });

  // Touch swipe for large tablets in book mode; vertical scrolling and pinch zoom stay native.
  let start: { x: number; y: number; id: number } | null = null;
  book.addEventListener('pointerdown', event => {
    if (event.pointerType === 'mouse' || (event.target as Element).closest('a, button')) return;
    start = { x: event.clientX, y: event.clientY, id: event.pointerId };
  });
  book.addEventListener('pointerup', event => {
    if (!active() || !start || start.id !== event.pointerId) return;
    const dx = event.clientX - start.x, dy = event.clientY - start.y;
    start = null;
    if (Math.abs(dx) > 65 && Math.abs(dx) > Math.abs(dy) * 1.6) step(dx < 0 ? 1 : -1);
  });
  book.addEventListener('pointercancel', () => { start = null; });
</script>
